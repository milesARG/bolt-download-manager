{
  "manifest_version": 3,
  "name": "Bolt Download Manager",
  "short_name": "Bolt",
  "version": "1.5.0",
  "description": "Sends your downloads to Bolt for fast multi-connection, resumable downloading, and finds videos on pages. Made by Arnav.",
  "key": "",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "notifications", "scripting", "activeTab", "nativeMessaging", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Bolt Download Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "web_accessible_resources": [{ "resources": ["caught.html"], "matches": ["<all_urls>"] }],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "minimum_chrome_version": "116"
}
